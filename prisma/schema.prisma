generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id               String       @id @default(cuid())
  source           String
  sourceId         String
  sourceUrl        String
  dedupKey         String
  channel          String // "REDDIT_DM" | "EMAIL"
  status           String       @default("NEW") // NEW | DISQUALIFIED | PURSUE_NOW | PURSUE | MAYBE_LATER | REJECTED | APPROVED | SENT
  profile          String // JSON FounderProfile
  rawPayload       String // JSON raw source object
  disqualifyReason String?
  error            String?
  activityAt       DateTime? // founder's last activity at the source (freshness)
  outcome          String? // NO_REPLY | INTERESTED | BOOKED_CALL | CLIENT | WRONG_ICP
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  evaluations      Evaluation[]
  drafts           Draft[]

  @@unique([source, sourceId])
  @@index([dedupKey])
  @@index([status])
}

model Evaluation {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  summary           String
  observedFacts     String // JSON string[]
  inferences        String // JSON {text, confidence}[]
  scores            String // JSON EvaluationResult["scores"]
  whyNow            String?
  risks             String // JSON string[]
  missingInfo       String // JSON string[]
  overallConfidence String
  weighted          Float
  decision          String // PURSUE_NOW | PURSUE | MAYBE_LATER | REJECTED
  reason            String
  snapshot          String? // JSON 30-second brief {problem, biggestCompetitor, biggestOpportunity, suggestedHook}
  reportValue       String? // JSON {stars, sections[], reason}
  createdAt         DateTime @default(now())
}

model Draft {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  primaryHook    String
  desiredOutcome String
  callToAction   String
  message        String
  editedMessage  String?
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Config {
  key   String @id
  value String // JSON-encoded
}
